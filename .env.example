# ==============================================================================
# ST PRODUCTION HOUSE UNIFIED - NON-OPERATIONAL ENVIRONMENT PLACEHOLDERS
# ==============================================================================
# Do not include reusable passwords, production keys, or live credentials.
#
# PRIVILEGED DATABASE PROVISIONING IDENTITY:
# Used solely for schema creation, bootstrapping, or running migrations.
# Example: postgresql://<ADMIN-USER>:<SET-VIA-SECRET-MANAGER>@localhost:5432/st_production
#
# RUNTIME IDENTITY (LEAST-PRIVILEGE):
# Used by the production control plane during normal execution.
# Example: postgresql://<DB-USER>:<SET-VIA-SECRET-MANAGER>@localhost:5432/st_production
# ==============================================================================

DATABASE_URL=postgresql://<DB-USER>:<SET-VIA-SECRET-MANAGER>@localhost:5432/st_production_test
REDIS_URL=redis://localhost:6379
SESSION_SECRET_REF=vault://st/session-signing-key
POSTIZ_BASE_URL=http://postiz:5000
POSTIZ_API_KEY_REF=vault://st/services/postiz/api-key
DEFAULT_PUBLISHING_MODE=draft
ALLOW_LIVE_PUBLISHING=false

# PostgreSQL Adapter Configuration Options (Least-Privilege Runtime)
PGHOST=localhost
PGPORT=5432
PGUSER=<DB-USER>
PGPASSWORD=<SET-VIA-SECRET-MANAGER>
PGDATABASE=st_production_test
PGMAXPOOL=10
PGIDLETIMEOUT=30000
PGCONNECTTIMEOUT=5000
PGSTATEMENTTIMEOUT=30000
PGSSLMODE=disable
PGSSL_REJECT_UNAUTHORIZED=true

# Agent Digital Identity Secret Manager Reference Architecture
OAUTH_SECRET_BROKER_URL=vault://st/secrets-broker

# Security & Bootstrap Variables (Use unmistakable placeholder values only)
BOOTSTRAP_OWNER_EMAIL=bootstrap_owner_placeholder@example.com
BOOTSTRAP_OWNER_PASSWORD=<SET-VIA-SECRET-MANAGER>
MFA_ENCRYPTION_KEY=<SET-VIA-SECRET-MANAGER>
USE_PG=true
