# References only. Never put provider secrets in browser variables or source control.
DATABASE_URL=postgresql://st_app:change-me@localhost:5432/st_production
REDIS_URL=redis://localhost:6379
SESSION_SECRET_REF=vault://st/session-signing-key
POSTIZ_BASE_URL=http://postiz:5000
POSTIZ_API_KEY_REF=vault://st/services/postiz/api-key
DEFAULT_PUBLISHING_MODE=draft
ALLOW_LIVE_PUBLISHING=false

# PostgreSQL Adapter Configuration Options (Optional Overrides)
PGHOST=localhost
PGPORT=5432
PGUSER=st_app
PGPASSWORD=change-me
PGDATABASE=st_production
PGMAXPOOL=10
PGIDLETIMEOUT=30000
PGCONNECTTIMEOUT=5000
PGSTATEMENTTIMEOUT=30000
PGSSLMODE=disable
PGSSL_REJECT_UNAUTHORIZED=true

# Agent Digital Identity Secret Manager Reference Architecture
# Credentials and OAuth tokens are stored in an external secrets manager and referenced via:
# vault://st/agents/<agent-id>/connections/<platform>/<account-id>
OAUTH_SECRET_BROKER_URL=vault://st/secrets-broker
