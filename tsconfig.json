{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/types/**/*.ts", "src/data/**/*.ts", "src/store/**/*.ts", "src/utils/**/*.ts", "src/components/**/*.tsx", "src/screens/**/*.tsx", "src/api/**/*.ts", "src/api/**/*.js"]
}
