{
  "name": "st-production-house-unified",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secure control-plane foundation for ST Production House",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "node --check server.js && node --check src/catalog/server.js",
    "start": "node server.js",
    "lint": "node .github/scripts/repo-lint.mjs",
    "ci": "npm run lint && npm run verify",
    "test": "node --test --test-concurrency=1",
    "plan:check": "node automation/validate-plan.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/postgresIntegration.integration.js tests/postgresAuthIntegration.integration.js tests/credentialBrokerPostgres.integration.js tests/postgresCredentialBrokerIntegration.integration.js tests/postgresNightShiftIntegration.integration.js",
    "migrate": "node -e \"import('./src/db/index.js').then(m => m.runMigrations(m.createPostgresAdapter())).then(r => console.log(JSON.stringify({code:'MIGRATIONS_COMPLETE',appliedCount:r.appliedCount}))).catch(e => {console.error(e); process.exit(1)})\"",
    "migrate:status": "node -e \"import('./src/db/index.js').then(m => m.getMigrationStatus(m.createPostgresAdapter())).then(s => console.log(JSON.stringify({code:'MIGRATION_STATUS',migrations:s}))).catch(e => {console.error(e); process.exit(1)})\"",
    "verify": "node --check server.js && node --check src/catalog/agents.js && node --check src/catalog/ownerAuthentication.js && node --check src/catalog/repositories.js && node --check src/catalog/server.js && node --check src/db/index.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
